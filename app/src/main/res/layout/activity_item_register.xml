<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="새 물품 등록"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etRegisterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="책 제목을 입력하세요"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <Spinner
        android:id="@+id/spinnerRegisterCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgTransactionType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbSell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="판매"
            android:checked="true"
            android:layout_marginEnd="16dp"/>

        <RadioButton
            android:id="@+id/rbRent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="대여"/>
    </RadioGroup>

    <EditText
        android:id="@+id/etRegisterPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="가격을 입력하세요 (원)"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etMaxRentDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="최대 대여 가능 일수 (예: 7)"
        android:inputType="number"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvRentalEndDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="대여 가능 기한 선택 (예: 2026-06-20)"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="?android:attr/editTextBackground"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/ivItemPreview"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginBottom="8dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:background="#EEEEEE"/>

    <Button
        android:id="@+id/btnSelectImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="24dp"
        android:text="이미지 추가"
        android:backgroundTint="#808080"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnSubmitItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="등록 완료"/>

</LinearLayout>